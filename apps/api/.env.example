# ── Required ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/rit
JWT_SECRET=replace-me-with-a-high-entropy-random-string

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8888
NODE_ENV=development
JWT_EXPIRES_IN=7d
# Comma-separated allowed origins in production. localhost is always allowed.
CORS_ORIGIN=
# Reverse-proxy hops in front of the API. Drives req.ip, which every rate
# limiter keys on. 1 for Railway; 2 if fronted by Cloudflare too. Never `true`.
TRUST_PROXY=1
WEB_URL=http://localhost:4321

# ── LLM features (translation + recipe drafting from photos) ──────────────────
# Both features are off entirely when the key is unset.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Set to false to disable machine translation without removing the key.
TRANSLATION_ENABLED=true
# Set to false to disable AI recipe drafting without removing the key.
AI_DRAFTING_ENABLED=true

# ── Media storage (plating photos, training video) ────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
