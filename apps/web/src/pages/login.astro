---
import BaseLayout from '../layouts/BaseLayout.astro';
import { LoginForm } from '../components/LoginForm';
import { siteName, siteTagline } from '../assets/site-content/site-info';

// Only ever read on the client — the page itself is a static shell.
const next = Astro.url.searchParams.get('next') ?? '/';
const suspended = Astro.url.searchParams.get('suspended') === '1';
---

<BaseLayout title="Sign in" requireAuth={false}>
  <div class="mx-auto w-full max-w-md py-8 tablet:py-16">
    <h1 class="text-2xl font-semibold text-steel-900">{siteName}</h1>
    <p class="mt-1 mb-6 text-sm text-salt-600">{siteTagline}</p>

    {
      suspended && (
        <p
          role="alert"
          class="mb-4 rounded-md border border-chili-200 bg-chili-50 px-3 py-2 text-sm text-chili-700"
        >
          Your account has been suspended. Contact your administrator.
        </p>
      )
    }

    <div class="rounded-lg border border-salt-300 bg-white p-6 shadow-sm">
      <LoginForm client:load next={next} />
    </div>

    <p class="mt-4 text-center text-sm text-salt-600">
      New here?
      <a href="/signup" class="font-medium text-ember-600 hover:text-ember-700">Create an account</a>
    </p>
  </div>
</BaseLayout>
