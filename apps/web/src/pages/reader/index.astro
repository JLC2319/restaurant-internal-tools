---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ScopeSwitcher } from '../../components/ScopeSwitcher';
import { ReaderBrowser } from '../../components/ReaderBrowser';
---

<BaseLayout title="Reader">
  <ScopeSwitcher client:load slot="header-actions" />

  <header class="max-w-2xl">
    <p class="text-xs font-semibold tracking-widest text-ember-600 uppercase">Reader</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-steel-900">On the line</h1>
    <p class="mt-2 text-sm text-salt-600">
      Live recipes and published training only — everything on this screen has been approved.
      Drafts and works-in-progress never appear here.
    </p>
  </header>

  <div class="mt-6 tablet:mt-8">
    <ReaderBrowser client:load />
  </div>
</BaseLayout>
