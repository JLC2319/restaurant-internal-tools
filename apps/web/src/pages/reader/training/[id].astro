---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { ReaderTraining } from '@/features/reader/ReaderTraining';

// On-demand only: training ids are runtime data, not a build-time route list.
export const prerender = false;

const { id } = Astro.params;
---

<BaseLayout title="Training">
  <ScopeSwitcher client:load slot="header-actions" />
  <ReaderTraining client:load trainingId={id!} />
</BaseLayout>
