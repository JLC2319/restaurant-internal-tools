---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { ProfileSettings } from '@/features/settings/ProfileSettings';
---

<BaseLayout title="Your profile">
  <ScopeSwitcher client:load slot="header-actions" />

  <PageHeader
    eyebrow="Account"
    title="Your profile"
    subtitle="Your details, language, password and everywhere you have access."
  />

  {
    /* Wider than the old single column: the shell puts a sidebar beside the
      content on laptop and up. */
  }
  <div class="mt-6 max-w-5xl tablet:mt-8">
    <ProfileSettings client:load />
  </div>
</BaseLayout>
