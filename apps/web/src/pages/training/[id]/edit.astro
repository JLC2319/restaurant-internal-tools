---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { TrainingEditor } from '@/features/training/TrainingEditor';

// On-demand only: training ids are runtime data, not a build-time route list.
export const prerender = false;

const { id } = Astro.params;
---

<BaseLayout title="Edit training">
  <ScopeSwitcher client:load slot="header-actions" />
  <TrainingEditor client:load trainingId={id!} />
</BaseLayout>
