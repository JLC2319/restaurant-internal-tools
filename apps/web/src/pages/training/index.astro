---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { TrainingsBrowser } from '@/features/training/TrainingsBrowser';
---

<BaseLayout title="Training">
  <ScopeSwitcher client:load slot="header-actions" />

  <PageHeader
    eyebrow="Team training"
    title="Training"
    subtitle="Modules built from rich text, photos and video. Staff see published modules and mark them complete; chefs draft, publish and track completion."
  />

  <div class="mt-6 tablet:mt-8">
    <TrainingsBrowser client:load />
  </div>
</BaseLayout>
