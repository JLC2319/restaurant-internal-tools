---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { TrainingDraft } from '@/features/training/TrainingDraft';
---

<BaseLayout title="Draft trainings with AI">
  <ScopeSwitcher client:load slot="header-actions" />

  <header class="max-w-2xl">
    <a
      href="/training"
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-salt-600 transition-colors hover:text-steel-900"
    >
      ← Training
    </a>
    <p class="mt-3 text-xs font-semibold tracking-widest text-ember-600 uppercase">AI drafting</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-steel-900">
      Draft trainings from your material
    </h1>
    <p class="mt-2 text-sm text-salt-600">
      Describe the module and attach handbook pages, SOPs or PDFs — structured draft modules come
      back. You review every proposal before anything is created.
    </p>
  </header>

  <div class="mt-6 tablet:mt-8">
    <TrainingDraft client:load />
  </div>
</BaseLayout>
