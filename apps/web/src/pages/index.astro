---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ScopeSwitcher } from '../components/ScopeSwitcher';
import { siteTagline } from '../assets/site-content/site-info';
import {
  ArrowRight,
  BookOpen,
  FlaskConical,
  GraduationCap,
  Languages,
  ShieldAlert,
  Tablet,
} from 'lucide-react';

// The Phase 1 wedge, as the planning doc defines it. Cards without `built` link
// to a route that does not exist yet — build the API feature first (see
// apps/api/src/features/<name>/README.md), then the page.
const phaseOne = [
  {
    title: 'Recipes',
    href: '/recipes',
    icon: BookOpen,
    blurb: 'Structured recipes, sub-recipes, yields, versioning, forking and allergen tags.',
    built: true,
  },
  {
    title: 'Translation review',
    href: '/translations',
    icon: Languages,
    blurb: 'Machine EN→ES drafts queued for human approval before anything publishes.',
    built: false,
  },
  {
    title: 'Allergen lookup',
    href: '/allergens',
    icon: ShieldAlert,
    blurb: 'Exclusion-based search: what a guest with these allergens must avoid.',
    built: false,
  },
  {
    title: 'R&D bank',
    href: '/rd-bank',
    icon: FlaskConical,
    blurb: 'Chefs submit ideas; directors review, rank and track versions.',
    built: false,
  },
  {
    title: 'Training',
    href: '/training',
    icon: GraduationCap,
    blurb: 'Modules and materials, translated through the same review gate.',
    built: false,
  },
  {
    title: 'Reader',
    href: '/reader',
    icon: Tablet,
    blurb: 'iPad-first read-only view for the line. Approved content only.',
    built: false,
  },
];
---

<BaseLayout title="Dashboard">
  <ScopeSwitcher client:load slot="header-actions" />

  <header class="max-w-2xl">
    <p class="text-xs font-semibold tracking-widest text-ember-600 uppercase">Dashboard</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-steel-900 tablet:text-4xl">
      Everything your kitchen
      <span class="bg-linear-to-r from-ember-500 to-ember-700 bg-clip-text text-transparent"
        >runs on</span
      >.
    </h1>
    <p class="mt-3 text-md text-salt-600">{siteTagline}</p>
  </header>

  <ul class="mt-8 grid gap-4 tablet:mt-10 tablet:grid-cols-2 desktop:grid-cols-3">
    {
      phaseOne.map(({ title, href, blurb, icon: Icon, built }) =>
        built ? (
          <li>
            <a
              href={href}
              class="group flex h-full flex-col rounded-2xl bg-white p-5 shadow-sm ring-1 ring-salt-200 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-ember-600/10 hover:ring-ember-300"
            >
              <div class="flex items-start justify-between gap-2">
                <span class="flex size-11 items-center justify-center rounded-xl bg-linear-to-br from-ember-400 to-ember-600 text-white shadow-md shadow-ember-600/25">
                  <Icon className="size-5" aria-hidden />
                </span>
              </div>
              <h2 class="mt-4 font-semibold text-steel-900">{title}</h2>
              <p class="mt-1.5 flex-1 text-sm text-salt-600">{blurb}</p>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-ember-600 transition-colors group-hover:text-ember-700">
                Open
                <ArrowRight
                  className="size-4 transition-transform duration-200 group-hover:translate-x-0.5"
                  aria-hidden
                />
              </span>
            </a>
          </li>
        ) : (
          <li class="flex h-full flex-col rounded-2xl bg-white/60 p-5 ring-1 ring-salt-200">
            <div class="flex items-start justify-between gap-2">
              <span class="flex size-11 items-center justify-center rounded-xl bg-salt-100 text-salt-500 ring-1 ring-salt-200 ring-inset">
                <Icon className="size-5" aria-hidden />
              </span>
              <span class="rounded-full bg-salt-100 px-2.5 py-1 text-2xs font-semibold tracking-wide text-salt-600 uppercase ring-1 ring-salt-200 ring-inset">
                Coming soon
              </span>
            </div>
            <h2 class="mt-4 font-semibold text-steel-700">{title}</h2>
            <p class="mt-1.5 flex-1 text-sm text-salt-500">{blurb}</p>
          </li>
        )
      )
    }
  </ul>
</BaseLayout>
