---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { OrgSettings } from '@/features/settings/OrgSettings';
---

<BaseLayout title="Organization">
  <ScopeSwitcher client:load slot="header-actions" />

  <PageHeader
    eyebrow="Organization"
    title="Organization settings"
    subtitle="Company details, publishing, structure and membership. What you can change depends on your role."
  />

  {/* One island: the settings shell owns the section nav, and every section
      shares its QueryProvider cache rather than refetching per card. */}
  <div class="mt-6 max-w-5xl tablet:mt-8">
    <OrgSettings client:load />
  </div>
</BaseLayout>
