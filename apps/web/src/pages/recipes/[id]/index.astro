---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { RecipeDetail } from '@/features/recipes/RecipeDetail';

// On-demand only: recipe ids are runtime data, not a build-time route list.
export const prerender = false;

const { id } = Astro.params;
---

<BaseLayout title="Recipe">
  <ScopeSwitcher client:load slot="header-actions" />
  <RecipeDetail client:load recipeId={id!} />
</BaseLayout>
