---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { RecipeEditor } from '@/features/recipes/RecipeEditor';

// On-demand only: recipe ids are runtime data, not a build-time route list.
export const prerender = false;

const { id } = Astro.params;
---

<BaseLayout title="Edit recipe">
  <ScopeSwitcher client:load slot="header-actions" />
  <RecipeEditor client:load recipeId={id!} />
</BaseLayout>
