---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { ScopeSwitcher } from '@/features/tenancy/ScopeSwitcher';
import { RecipesTable } from '@/features/recipes/RecipesTable';
---

<BaseLayout title="Recipes">
  <ScopeSwitcher client:load slot="header-actions" />

  <PageHeader
    eyebrow="Recipe book"
    title="Recipes"
    subtitle="Staff see the live version of each dish. Chefs draft, version, publish and fork."
  />

  <div class="mt-6 tablet:mt-8">
    <RecipesTable client:load />
  </div>
</BaseLayout>
