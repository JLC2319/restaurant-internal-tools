---
import CommonHead from '@/layouts/CommonHead.astro';
import { siteShortName, navLinks } from '@/assets/site-content/site-info';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Send unauthenticated visitors to /login before first paint. */
  requireAuth?: boolean;
}

const { title, description, requireAuth = true } = Astro.props;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);

const navLinkClass = (href: string) =>
  isActive(href)
    ? 'bg-steel-900 text-salt-50 shadow-sm'
    : 'text-steel-600 hover:bg-salt-100 hover:text-steel-900';
---

<html lang="en" class="h-full">
  <head>
    <CommonHead title={title} description={description} />

    <!--
      Runs before first paint so auth-gated content never flashes. It sets the
      `data-authed` attribute that global.css keys off, and redirects when a
      page needs auth. Inline (not bundled) so it re-runs on every navigation.
    -->
    <script is:inline define:vars={{ requireAuth }}>
      (function () {
        var token = localStorage.getItem('rit_token');
        if (token) {
          document.documentElement.setAttribute('data-authed', '');
        } else {
          document.documentElement.removeAttribute('data-authed');
          if (requireAuth && location.pathname !== '/login') {
            location.replace('/login?next=' + encodeURIComponent(location.pathname));
          }
        }
      })();
    </script>
  </head>

  <body class="relative min-h-full flex flex-col bg-salt-50 text-steel-900 font-sans antialiased">
    <!-- Aurora backdrop: two soft brand-tinted glows behind everything. -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div
        class="absolute -top-40 right-[-10%] h-120 w-120 rounded-full bg-ember-100/60 blur-3xl"
      >
      </div>
      <div
        class="absolute top-[30%] left-[-15%] h-105 w-105 rounded-full bg-basil-100/50 blur-3xl"
      >
      </div>
    </div>

    <header
      class="sticky top-0 z-40 border-b border-salt-200/80 bg-white/70 backdrop-blur-xl"
      data-requires-auth
    >
      <div class="mx-auto flex max-w-[1400px] items-center gap-4 px-4 py-2.5 tablet:px-6">
        <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="Dashboard">
          <span
            class="flex size-9 items-center justify-center rounded-xl bg-linear-to-br from-ember-400 to-ember-600 text-white shadow-md shadow-ember-600/30"
          >
            <!-- Flame mark -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4.5" aria-hidden="true">
              <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
            </svg>
          </span>
          <span class="text-lg font-bold tracking-tight text-steel-900">{siteShortName}</span>
        </a>

        <nav aria-label="Main navigation" class="hidden tablet:flex items-center gap-1">
          {
            navLinks.map(({ label, href }) => (
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class={`rounded-full px-3.5 py-2 text-sm font-medium transition-all duration-150 ${navLinkClass(href)}`}
              >
                {label}
              </a>
            ))
          }
        </nav>

        <div class="ml-auto flex items-center gap-2">
          <slot name="header-actions" />
        </div>
      </div>

      <!-- Below tablet the nav wraps to its own scrollable row. -->
      <nav
        aria-label="Main navigation"
        class="flex gap-1 overflow-x-auto border-t border-salt-200/80 px-4 pb-2 pt-1 tablet:hidden"
      >
        {
          navLinks.map(({ label, href }) => (
            <a
              href={href}
              aria-current={isActive(href) ? 'page' : undefined}
              class={`min-h-touch flex shrink-0 items-center rounded-full px-3.5 py-2 text-sm font-medium transition-all duration-150 ${navLinkClass(href)}`}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </header>

    <main class="mx-auto w-full max-w-[1400px] flex-1 px-4 py-6 tablet:px-6 tablet:py-10">
      <div class="animate-fade-up">
        <slot />
      </div>
    </main>

    <footer class="border-t border-salt-200/80 px-4 py-6 text-center text-xs text-salt-600">
      Internal use only · Allergen information requires human verification before service.
    </footer>
  </body>
</html>
