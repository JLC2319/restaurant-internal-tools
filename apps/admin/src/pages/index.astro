---
import AdminLayout from '../layouts/AdminLayout.astro';
import { StatsCards } from '../components/StatsCards';
---

<AdminLayout title="Overview">
  <h1 class="text-2xl font-semibold text-steel-900">Platform overview</h1>
  <p class="mt-1 text-sm text-salt-600">Live counts across every tenant.</p>

  <div class="mt-6">
    <StatsCards client:load />
  </div>

  <div class="mt-8 grid gap-4 tablet:grid-cols-2">
    <a
      href="/organizations"
      class="rounded-lg border border-salt-300 bg-white p-4 shadow-sm transition-colors hover:border-ember-300"
    >
      <h2 class="font-semibold text-steel-900">Organizations</h2>
      <p class="mt-1 text-sm text-salt-600">
        Provision a new customer, inspect a tenant's tree, suspend or reactivate.
      </p>
    </a>
    <a
      href="/users"
      class="rounded-lg border border-salt-300 bg-white p-4 shadow-sm transition-colors hover:border-ember-300"
    >
      <h2 class="font-semibold text-steel-900">Users</h2>
      <p class="mt-1 text-sm text-salt-600">
        Search accounts, verify emails, suspend, and manage platform staff.
      </p>
    </a>
  </div>
</AdminLayout>
