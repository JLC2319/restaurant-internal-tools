{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm build)",
      "Bash(pnpm build:shared)",
      "Bash(pnpm build:api)",
      "Bash(pnpm build:web)",
      "Bash(pnpm build:admin)",
      "Bash(pnpm install)",
      "Bash(pnpm --filter @rit/api test)",
      "Bash(pnpm --filter @rit/shared test)",
      "Bash(pnpm --filter @rit/api typecheck)",
      "Bash(pnpm --filter @rit/shared typecheck)",
      "Bash(pnpm --filter @rit/mobile typecheck)",
      "Bash(pnpm --filter @rit/mobile lint)",
      "Bash(pnpm --filter @rit/scripts typecheck)",
      "Bash(pnpm --filter @rit/web typecheck)",
      "Bash(pnpm --filter @rit/admin typecheck)",
      "Bash(npx vitest run:*)",
      "Bash(npx prettier:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ]
  }
}
