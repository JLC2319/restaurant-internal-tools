{
  "name": "restaurant-internal-tools",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' --filter '!@rit/mobile' dev",
    "dev:all": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "dev:api": "pnpm --filter @rit/api dev",
    "dev:web": "pnpm --filter @rit/web dev",
    "dev:admin": "pnpm --filter @rit/admin dev",
    "dev:mobile": "pnpm --filter @rit/mobile dev",
    "dev:mobile:ios": "pnpm --filter @rit/mobile ios",
    "dev:mobile:sims": "pnpm --filter @rit/mobile ios:sims",
    "dev:mobile:android": "pnpm --filter @rit/mobile android",
    "build:shared": "pnpm --filter @rit/shared build",
    "build:api": "pnpm --filter @rit/shared build && pnpm --filter @rit/api build",
    "build:web": "pnpm --filter @rit/shared build && pnpm --filter @rit/web build",
    "build:admin": "pnpm --filter @rit/shared build && pnpm --filter @rit/admin build",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build:shared && pnpm -r test",
    "test:coverage": "pnpm build:shared && pnpm -r test:coverage",
    "script": "pnpm --filter @rit/scripts exec"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
