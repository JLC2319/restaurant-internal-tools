{
  "name": "restaurant-internal-tools",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "dev:api": "pnpm --filter @rit/api dev",
    "dev:web": "pnpm --filter @rit/web dev",
    "build:shared": "pnpm --filter @rit/shared build",
    "build:api": "pnpm --filter @rit/shared build && pnpm --filter @rit/api build",
    "build:web": "pnpm --filter @rit/shared build && pnpm --filter @rit/web build",
    "typecheck": "pnpm --filter @rit/shared typecheck && pnpm --filter @rit/api typecheck",
    "lint": "pnpm --filter @rit/web lint",
    "test": "pnpm --filter @rit/shared test && pnpm --filter @rit/api test",
    "test:coverage": "pnpm --filter @rit/shared test:coverage && pnpm --filter @rit/api test:coverage",
    "script": "pnpm --filter @rit/scripts exec"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  }
}
